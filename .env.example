# Livestock API (marketplace, breeds, ranches, animals, herd health, auth)
# Leave empty for local Vite proxy → http://localhost:8000
VITE_LIVESTOCK_API_URL=

# News Feed API (agriculture headlines + digests)
VITE_NEWS_API_URL=https://oatmeal-ai.com

# Optional Saige advisory chat widget
# Local default in SaigeWidget is http://127.0.0.1:8002 when unset in DEV.
# Staging/prod: set via STAGING_SAIGE_URL / PROD_SAIGE_URL build vars.
VITE_SAIGE_API_URL=http://127.0.0.1:8002

# Contact form recipient (FormSubmit)
VITE_CONTACT_EMAIL=livestockoftheworld@gmail.com
