# Livestock API (marketplace, breeds, ranches, auth)
# Leave empty for local Vite proxy → http://localhost:8000
VITE_LIVESTOCK_API_URL=

# OFN main backend — plant & ingredient knowledgebases
# Leave empty in local dev to proxy those routes to the default OFN Cloud Run API.
# For Cloud builds, set explicitly (same host OFN frontend used).
VITE_OFN_API_URL=https://oatmealfarmnewtorkbackend-802455386518.us-central1.run.app

# News feed API
VITE_NEWS_API_URL=https://oatmeal-ai.com

VITE_SAIGE_API_URL=
# Contact form recipient (FormSubmit) — same role as OFN VITE_CONTACT_RECIPIENT_EMAIL
VITE_CONTACT_EMAIL=livestockoftheworld@gmail.com
