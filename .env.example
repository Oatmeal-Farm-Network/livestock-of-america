# Local Vite defaults. Cloud builds bake these via Docker ARG.
# LOA talks only to the livestock Cloud Run service (not OFN main backend).
#
# Leave empty for local Vite proxy → http://localhost:8000 (see vite.config.ts).
# Set absolute URL for staging/prod Docker builds.
VITE_LIVESTOCK_API_URL=
VITE_SAIGE_API_URL=
VITE_CONTACT_EMAIL=
